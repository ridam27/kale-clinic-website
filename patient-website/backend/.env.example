PATIENT_API_PORT=4000

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kale_clinic?schema=public"

# Email Service (Dual Failover: Gmail SMTP -> Resend)
EMAIL_PRIMARY_PROVIDER="gmail"
GMAIL_USER="doctor@gmail.com"
GMAIL_APP_PASSWORD="16-character-app-password"
CLINIC_FROM_NAME="Dr. Kale Clinic"
RESEND_API_KEY="re_placeholder_api_key"
RESEND_FROM_ADDRESS="consultations@doctor-domain.com"

