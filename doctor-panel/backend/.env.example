# ==============================================================================
# Doctor Panel Backend (.env.example)
# ==============================================================================
DOCTOR_API_PORT=4001
VIDEO_API_URL="http://localhost:4002"

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kale_clinic?schema=public"

# Storage (Cloudflare R2 / S3 - Prescriptions)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="kale-clinic-prescriptions"
R2_ENDPOINT="https://<your-account-id>.r2.cloudflarestorage.com"

